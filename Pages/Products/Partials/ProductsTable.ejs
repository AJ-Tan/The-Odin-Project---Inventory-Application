<table>
  <tr>
    <th>id</th>
    <th>Name</th>
    <th>Price</th>
    <th>Controls</th>
  </tr>
  <% for(const row of productsData) { %>
      <tr>
        <td><%= row.id %></td>
        <td><%= row.name %></td>
        <td class="capitalize" >₱ <%= Number(row.price).toLocaleString() %></td>
        <td>
          <div class="tr-controls">
            <a class="tbl-btn tbl-btn-update" href="/settings/category/<%= row.id %>">Update</a>
            <form action="/settings/category/delete/<%= row.id %>" method="post">
              <button type="submit" class="tbl-btn tbl-btn-delete" onclick="return confirm('Are you sure you want to delete this item?')">Delete</button>
            </form>
          </div>
        </td>
      </tr>
  <% } %>
</table>
