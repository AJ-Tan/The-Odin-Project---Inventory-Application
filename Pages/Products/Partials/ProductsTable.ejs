<div class="table-controls">
  <a class="btn-link add" href="/products/form">Add</a>
</div>

<table>
  <tr>
    <th>id</th>
    <th>Name</th>
    <th>Categories</th>
    <th>Price</th>
    <th>Controls</th>
  </tr>
  <% for(const row of productsData) { %>
      <tr>
        <td><%= row.product_id %></td>
        <td><%= row.product_name %></td>
        <% const categories = row.categories?.split(", ") %>
        <td>
          <% if(categories) { %>
            <b><%= categories.length > 1 ? `${categories[0]},` : categories[0] %></b> 
            <%= categories.slice(1).join(", ") %>
          <% } %>
        </td>
        <td class="capitalize" >₱ <%= Number(row.product_price).toLocaleString() %></td>
        <td>
          <div class="tr-controls">
            <a class="tbl-btn tbl-btn-update" href="/products/form/<%= row.product_id %>">Update</a>
            <form action="/products/delete/<%= row.product_id %>" method="post">
              <button type="submit" class="tbl-btn tbl-btn-delete" onclick="return confirm('Are you sure you want to delete this item?')">Delete</button>
            </form>
          </div>
        </td>
      </tr>
  <% } %>
</table>
