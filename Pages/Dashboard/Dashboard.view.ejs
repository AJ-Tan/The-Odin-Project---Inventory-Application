<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard</title>
    <link rel="stylesheet" href="/Dashboard/dashboardStyle.css" />
  </head>
  <body>
    <div id="app">
      <%- include("../Common/Components/PageHeader/PageHeader.view.ejs", { active }) %>
      <main>
        <div class="main-wrapper">
          <header class="main-header">
            <h2>Dashboard</h2>
            <span>Overview of the current status.</span>
          </header>
          <div class="main-content dashboard">
            <ul class="dashboard-list">
              <li class="dashboard-item">
                <header class="item-header">
                  <h3>Quantity By Warehouse (TOP 5)</h3>
                </header>
                <ul class="item-content">
                  <% for(let item of warehouseItems) { %>
                    <li class="item-content-row">
                      <span class="item-title"><%= item.name %></span>
                      <span class="item-detail"><%= item.quantity %></span>
                    </li>
                  <% } %>
                </ul>
              </li>
              <li class="dashboard-item">
                <header class="item-header">
                  <h3>Quantity By Product (TOP 5)</h3>
                </header>
                <ul class="item-content">
                  <% for(let item of productItems) { %>
                    <li class="item-content-row">
                      <span class="item-title"><%= item.name %></span>
                      <span class="item-detail"><%= item.quantity %></span>
                    </li>
                  <% } %>
                </ul>
              </li>
              <li class="dashboard-item">
                <header class="item-header">
                  <h3>Quantity By Main Category (TOP 5)</h3>
                </header>
                <ul class="item-content">
                  <% for(let item of categoryItems) { %>
                    <li class="item-content-row">
                      <span class="item-title"><%= item.name %></span>
                      <span class="item-detail"><%= item.quantity %></span>
                    </li>
                  <% } %>
                </ul>
              </li>
            </ul>
            </ul>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>