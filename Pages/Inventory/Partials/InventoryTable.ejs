<div class="table-controls">
  <a class="btn-link add" href="/inventory/form">Add</a>
</div>

<table>
  <tr>
    <th>Product</th>
    <th>Warehouse</th>
    <th>Location</th>
    <th>Quantity</th>
    <th>Controls</th>
  </tr>
  <% for(const row of inventoryData) { %>
      <tr>
        <td><%= row.product %></td>
        <td><%= row.warehouse %></td>
        <td><%= row.location %></td>
        <td class="capitalize center" ><%= Number(row.quantity).toLocaleString() %></td>
        <td>
          <div class="tr-controls">
            <a class="tbl-btn tbl-btn-update" href="/inventory/form/<%= row.product_id %>/<%= row.warehouse_id %>">Update</a>
            <form action="/inventory/delete/<%= row.product_id %>/<%= row.warehouse_id %>" method="post">
              <button type="submit" class="tbl-btn tbl-btn-delete" onclick="return confirm('Are you sure you want to delete this item?')">Delete</button>
            </form>
          </div>
        </td>
      </tr>
  <% } %>
</table>
