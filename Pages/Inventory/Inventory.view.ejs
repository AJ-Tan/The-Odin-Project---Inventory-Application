<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Inventory</title>
    <link rel="stylesheet" href="/Inventory/inventoryStyle.css" />
  </head>
  <body>
    <div id="app">
      <%- include("../Common/Components/PageHeader/PageHeader.view.ejs", { active }) %>
      <%- include("../Common/Components/Notification/Notification.view.ejs", { active }) %>
      <main>
        <div class="main-wrapper">
          <header class="main-header">
            <h2>Inventory</h2>
            <span>Manage your inventory here.</span>
          </header>
          <div class="main-content">
            <% if(content === 'form') { %>
              <%- include("./Partials/InventoryForm.ejs") %>
            <% } else { %>
              <%- include("./Partials/InventoryTable.ejs") %>
            <% } %>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>