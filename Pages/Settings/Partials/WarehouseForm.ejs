<form
  class="form-data"
  action="/settings/warehouse/<%= item.id %>"
  method="post"
  onsubmit="disableSubmit(this)"
>
  <div class="form-header">
    <h3>
      <span class="capitalize"><%= params.id ? 'Update' : 'Add' %></span>
      Warehouse
    </h3>
  </div>
  <label
    >*Name:
    <input type="text" name="name" value="<%= item.name || '' %>" required
  /></label>
  <label>
    Location:
    <textarea name="location"><%= item.location || '' %></textarea>
  </label>
  <button type="submit">
    <span class="capitalize"><%= params.id ? 'Update' : 'Add' %></span>
  </button>
</form>

<script>
  function disableSubmit(form) {
    const submitButton = form.querySelector("button");
    submitButton.disabled = true;
  }
</script>
