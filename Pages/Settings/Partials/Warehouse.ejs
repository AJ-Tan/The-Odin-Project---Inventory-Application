<div class="settings-table">
  <div class="table-controls">
    <a class="btn-link add" href="/settings/warehouse/">Add</a>
  </div>

  <table>
    <tr>
      <th>Name</th>
      <th>Location</th>
      <th>Status</th>
      <th>Controls</th>
    </tr>
    <% for(const row of tblData) { %>
      <tr>
        <td><%= row.name %></td>
        <td><%= row.location %></td>
        <td class="capitalize" ><%= row.status %></td>
        <td>
          <div class="tr-controls">
            <a class="tbl-btn tbl-btn-update" href="/settings/warehouse/<%= row.id %>">Update</a>
            <form action="/settings/warehouse/delete/<%= row.id %>" method="post">
              <button type="submit" class="tbl-btn tbl-btn-delete" onclick="return confirm('Are you sure you want to delete this item?')">Delete</button>
            </form>
          </div>
        </td>
      </tr>
    <% } %>
  </table>
</div>