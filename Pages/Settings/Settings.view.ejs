<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Settings</title>
    <link rel="stylesheet" href="/Settings/settingsStyle.css" />
  </head>
  <body>
    <div id="app">
      <%- include("../Partials/PageHeader/PageHeader.view.ejs", { active }) %>
      <main>
        <div class="main-wrapper">
          <header class="main-header">
            <h2>Settings</h2>
            <span>Manage your dropdowns items here.</span>
          </header>

          <div class="main-content">
            <nav class="settings-nav">
              <ul>
                <li><a href="category">Category</a></li>
                <li><a href="warehouse">Warehouse</a></li>
              </ul>
            </nav>
            <% switch(settingActive) {
                case 'category': %>
                <%- include("./SettingsPartials/Category.view.ejs") %>
              <% break;
                 case 'warehouse':
              %>
                <%- include("./SettingsPartials/Warehouse.view.ejs") %>
              <% break;
              %>
            <% } %>
            
          </div>
        </div>
      </main>
    </div>
  </body>
</html>