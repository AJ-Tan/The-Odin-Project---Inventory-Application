<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Settings</title>
    <link rel="stylesheet" href="/Common/CSS/index.css" />
  </head>
  <body>
    <div id="app">
      <%- include("../Common/Components/PageHeader/PageHeader.view.ejs", { active }) %>
      <%- include("../Common/Components/Notification/Notification.view.ejs", { active }) %>
      <main>
        <div class="main-wrapper">
          <header class="main-header">
            <h2>Settings</h2>
            <span>Manage your dropdown items here.</span>
          </header>

          <div class="main-content">
            <nav class="settings-nav">
              <ul>
                <li class="<%= settingsContent === 'category' ? 'selected' : '' %>">
                  <a href="/settings?content=category">Category</a>
                </li>
                <li class="<%= settingsContent === 'warehouse' ? 'selected' : '' %>">
                  <a href="/settings?content=warehouse">Warehouse</a>
                </li>
                <li class="<%= settingsContent === 'misc' ? 'selected' : '' %>">
                  <a href="/settings?content=misc">Misc</a>
                </li>
              </ul>
            </nav>
            <div class="settings-content">
              <% switch(settingsContent) {
                  case 'category': %>
                    <% if(params?.content) { %>
                      <%- include("./Partials/CategoryForm.ejs") %>
                    <% } else { %>
                      <%- include("./Partials/Category.ejs") %>
                    <% } %>
                <% break;
                  case 'warehouse':
                %>
                  <% if(params?.content) { %>
                    <%- include("./Partials/WarehouseForm.ejs") %>
                  <% } else { %>
                    <%- include("./Partials/Warehouse.ejs") %>
                  <% } %>
                <% break;
                  case 'misc':
                %>
                  <%- include("./Partials/Misc.ejs") %>
                <% break;
                  default:
                %>
                  <span>Invalid parameter.</span>
              <% } %>
            </div>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>