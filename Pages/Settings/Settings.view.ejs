<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Settings</title>
    <link rel="stylesheet" href="/Settings/settingsStyle.css" />
  </head>
  <body>
    <div id="app">
      <%- include("../Partials/PageHeader/PageHeader.view.ejs", { active }) %>
      <main>
        <div class="main-wrapper">
          <header class="main-header">
            <h2>Settings</h2>
            <span>Manage your dropdown items here.</span>
          </header>

          <div class="main-content">
            <nav class="settings-nav">
              <ul>
                <li class="<%= settingActive === 'category' ? 'selected' : '' %>">
                  <a href="/settings/category">Category</a>
                </li>
                <li class="<%= settingActive === 'warehouse' ? 'selected' : '' %>">
                  <a href="/settings/warehouse">Warehouse</a>
                </li>
                <li class="<%= settingActive === 'misc' ? 'selected' : '' %>">
                  <a href="/settings/misc">Misc</a>
                </li>
              </ul>
            </nav>
            <div class="settings-content">
              <% switch(settingActive) {
                  case 'category': %>
                  <%- include("./SettingsPartials/Category.view.ejs", { tblData }) %>
                <% break;
                  case 'warehouse':
                %>
                  <%- include("./SettingsPartials/Warehouse.view.ejs", { tblData }) %>
                <% break;
                  case 'misc':
                %>
                  <%- include("./SettingsPartials/Misc.view.ejs", { tblData }) %>
                <% break;
                  default:
                %>
                  <span>Invalid parameter.</span>
              <% } %>
            </div>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>