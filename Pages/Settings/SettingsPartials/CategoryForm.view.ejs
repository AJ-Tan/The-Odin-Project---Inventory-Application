<form action="/settings/category/<%= settingAction %>/<%= item.id %>" method="post" onsubmit="disableSubmit(this)">
  <h3><span class="capitalize"><%= settingAction %></span> Category</h3>
  <label>*Name: <input type="text" name="name" value="<%= item.name || '' %>" required /></label>
  <label>
    Parent:
    <select name="parent_id">
      <option value="">Select (Optional)</option>
      <% for(const row of tblData) { %>
          <% if(row.id !== item.id) { %>
            <option value="<%= row.id %>" <%= row.id === item.parent_id ? 'selected' : '' %>><%= row.name %></option>
          <% } %>
        <% } %>
    </select>
  </label>
  <button type="submit"><span class="capitalize"><%= settingAction %></span></button>
</form>

<script>
function disableSubmit(form) {
  const submitButton = form.querySelector('button');
  submitButton.disabled = true;
}
</script>

