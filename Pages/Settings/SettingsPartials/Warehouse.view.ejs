<div class="settings-table">
  <div class="table-controls">
    <a class="btn-link add" href="/settings/warehouse/add">Add</a>
  </div>

  <table>
    <tr>
      <th>Name</th>
      <th>Location</th>
      <th>Status</th>
      <th>Controls</th>
    </tr>
    <% for(const row of tblData) { %>
      <tr>
        <td><%= row.name %></td>
        <td><%= row.location %></td>
        <td class="capitalize" ><%= row.status %></td>
        <td>
          <div class="tr-controls">
            <a class="tbl-btn tbl-btn-update" href="/settings/warehouse/update/<%= row.id %>">Update</a>
            <button class="tbl-btn tbl-btn-delete" type="button">Delete</button>
          </div>
        </td>
      </tr>
    <% } %>
  </table>
</div>