<form action="/settings/misc" method="post">
  <header class="form-header">
    <h3>Reset Data</h3>
    <span>Reset data to its default preset state.</span>
  </header>
  <div class="submit-group">
    <button
      type="submit"
      onclick="return confirm('Are you sure you want to proceed?');"
    >
      Reset
    </button>
    <span
      ><%= queries?.success === 't' ? `Database has been reset to its default
      state.` : '' %></span
    >
  </div>
</form>
